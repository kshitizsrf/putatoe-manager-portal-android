<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ProfileDetailsFieldsLayout">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="ProfileDetailsTextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:paddingVertical" tools:ignore="NewApi">8dp</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/matte_black</item>
    </style>
    <style name="ProfileDetailsEditText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:ems">8</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#55606B</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">6dp</item>
        <item name="android:inputType">textPersonName</item>
    </style>
    <style name="OrdersCategoryTextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/putatoe</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginHorizontal" tools:ignore="NewApi">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/textview_orders_category</item>
        <item name="android:padding">10dp</item>
    </style>
    <style name="OrdersPageHeadTextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>